{
  "name": "untube",
  "version": "2.6.1",
  "description": "Lightweight YouTube video metadata & streaming URL extractor for Node.js. High reliability ported from yt-dlp",
  "keywords": [
    "youtube",
    "yt-dlp",
    "youtube-dl",
    "metadata",
    "scraper",
    "downloader",
    "innertube",
    "youtube-api"
  ],
  "license": "Unlicense",
  "author": "Achmad Al Fandi",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aaf-30/untube.git"
  },
  "bugs": {
    "url": "https://github.com/aaf-30/untube/issues"
  },
  "homepage": "https://github.com/aaf-30/untube#readme",
  "engines": {
    "node": ">=20.18.1"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\" && tsc",
    "update-solver": "node scripts/update-solver.js",
    "prepare": "npm run build",
    "test": "node --test test/*.test.js"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "astring": "^1.9.0",
    "meriyah": "^7.1.0",
    "p-limit": "^7.3.0",
    "tough-cookie": "^6.0.1",
    "undici": "^7.24.3"
  }
}

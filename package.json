{
  "name": "untube",
  "version": "1.0.9",
  "description": "Lightweight YouTube video metadata and streaming URL extractor for Node.js. Features automatic signature decryption (n-parameter), proxy support, and cookie management. Ported from yt-dlp.",
  "keywords": [
    "youtube",
    "yt-dlp",
    "youtube-dl",
    "video-info",
    "metadata",
    "scraper",
    "downloader",
    "innertube",
    "signature-decryption",
    "undici",
    "youtube-api",
    "streaming-url"
  ],
  "license": "Unlicense",
  "author": "Achmad Al Fandi",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aaf-30/untube.git"
  },
  "bugs": {
    "url": "https://github.com/aaf-30/untube/issues"
  },
  "homepage": "https://github.com/aaf-30/untube#readme",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "npx tsc",
    "test": "echo \"Error: no test specified\" && exit 1",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@types/tough-cookie": "^4.0.5",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "tough-cookie": "^6.0.1",
    "undici": "^7.24.3"
  }
}